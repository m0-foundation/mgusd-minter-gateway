# Operator action scripts (block-user, unblock-user, pause, unpause) read
# their vault account ID + signing pubkey from a VARS block at the top of
# each script — NOT from .env. Edit the script before running.
#
# .env holds only:
#   - environment basics (RPC, network, Fireblocks API creds)
#   - CONTRACT_ID (the wrapper you operate against)
#   - legacy values for the pre-existing scripts (deploy, mint, burn, trustline)

# ── Shared (all scripts) ────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
HORIZON_URL=https://horizon-testnet.stellar.org
FIREBLOCKS_API_KEY=your-fireblocks-api-key
FIREBLOCKS_SECRET_PATH=./fireblocks-secret.key
FIREBLOCKS_ASSET_ID=XLM_TEST
FIREBLOCKS_BASE_PATH=sandbox                # optional — sandbox | us | eu | eu2

# The wrapper contract you operate against. All action scripts read this.
CONTRACT_ID=C...

# ── Legacy scripts only (deploy, mint, burn, trustline) ─────────────
# Issuer + Minter still use the env-based role config loaders.
ISSUER_FIREBLOCKS_VAULT_ACCOUNT_ID=0
ISSUER_PUBLIC_KEY=G...
MINTER_FIREBLOCKS_VAULT_ACCOUNT_ID=1
MINTER_PUBLIC_KEY=G...

# ── Contract role pubkeys (npm run deploy only) ─────────────────────
# These are contract-init arguments (who gets each role on-chain), NOT
# signer config. Required by `npm run deploy` for the initial role
# registry. Operator action scripts ignore these — they declare their
# signing pubkey inline in the script's VARS block.
ADMIN_PUBLIC_KEY=G...                          # M0 Foundation top-level authority
# MINTER_PUBLIC_KEY (above)                    # Bridge / Fireblocks minter — reused
YIELD_RECIPIENT_MANAGER_PUBLIC_KEY=G...        # M0 (rotates yield recipient)
YIELD_RECIPIENT_PUBLIC_KEY=G...                # MoneyGram (claims yield)
FORCED_TRANSFER_MANAGER_PUBLIC_KEY=G...        # Crossmint (compliance forced transfers)
PAUSER_PUBLIC_KEY=G...                         # Pauser of record

# ── Deploy (npm run deploy) ──────────────────────────────────────────
ASSET_CODE=TMGUSD                            # optional — defaults to TMGUSD

# WASM source — decision matrix (parity with scripts/deploy-pipeline.sh):
#
#   RELEASE_TAG=v1.0.0                       → download from GH release, verify
#                                              Sigstore attestation. RECOMMENDED.
#   WASM_PATH=... + ALLOW_UNATTESTED_WASM=1  → use a local file, skip attestation.
#                                              Dev iteration only.
#   WASM_PATH alone                          → HARD ERROR (forces explicit choice).
#   Both set                                 → RELEASE_TAG wins; WASM_PATH ignored.
#
# RELEASE_TAG=v1.0.0
# RELEASE_REPO=m0-foundation/mgusd-minter-gateway   # optional — default shown
# RELEASE_WASM_PATTERN=mintergateway_v*.wasm        # optional — default shown
# ALLOW_UNATTESTED_WASM=1                            # required when using WASM_PATH
WASM_PATH=./target/wasm32v1-none/release/mintergateway.wasm

# OPT-IN defense-in-depth: when set to "1" AND deploying via RELEASE_TAG, the
# script re-runs `stellar contract build` locally and refuses to deploy unless
# the freshly-built WASM matches the downloaded release byte-for-byte. Hard-
# errors if the Rust/Stellar toolchain is missing or HEAD doesn't point to the
# release commit. Skip if your machine can't reproduce the release.
# CROSS_VERIFY_LOCAL_BUILD=1

# Issuer home_domain (Stellar SEP-1). Wallets / explorers resolve token
# metadata from https://<HOME_DOMAIN>/.well-known/stellar.toml. Set in
# step 1's set_options op alongside the auth flags — one tx, one signature.
# Format: just the domain (no scheme, no path). Max 32 UTF-8 bytes.
#
# On-chain: OPTIONAL — Stellar accepts setOptions with or without it.
# In this script: env var is REQUIRED so the operator makes an explicit
# choice. To deploy WITHOUT a home_domain (skip SEP-1 wiring), set
# HOME_DOMAIN= (empty value). Can be added or changed later via:
#   npm run update-home-domain
HOME_DOMAIN=m0.foundation

# Operator-attested WASM hash. Compute with:
#   sha256sum ./target/wasm32v1-none/release/mintergateway.wasm
# The deploy script refuses to upload anything that doesn't match.
EXPECTED_WASM_SHA256=

# Throwaway local Stellar seed (S...) that signs the three protocol-
# permissionless deploy ops (SAC deploy, WASM upload, contract create).
# No privileged role on the resulting contract — abandon after deploy.
# Generate with: stellar keys generate --no-fund deployer && stellar keys show deployer
# Fund the derived G... pubkey with at least DEPLOYER_MIN_XLM XLM before running.
DEPLOYER_SECRET_KEY=

# Optional. Defaults shown.
# DEPLOY_RECEIPT_DIR=./deploys
# ISSUER_MIN_XLM=5
# DEPLOYER_MIN_XLM=3

# ── Trustline (npm run trustline) ────────────────────────────────────
TRUSTLINE_ASSET_CODE=TMGUSD                  # issuer read from ISSUER_PUBLIC_KEY

