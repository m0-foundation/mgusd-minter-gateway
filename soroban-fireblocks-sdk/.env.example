# Run `npm run cli -- --help` to see every command and which role it needs.
# Run `npm run cli -- roles` to see which roles your current env has set up.
#
# ── Shared (all scripts) ────────────────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FIREBLOCKS_API_KEY=your-fireblocks-api-key
FIREBLOCKS_SECRET_PATH=./fireblocks-secret.key
FIREBLOCKS_ASSET_ID=XLM_TEST
FIREBLOCKS_BASE_PATH=sandbox                # optional — sandbox | us | eu | eu2

# ── Issuer (Fireblocks account #1 — deploys) ────────────────────────
ISSUER_FIREBLOCKS_VAULT_ACCOUNT_ID=0
ISSUER_PUBLIC_KEY=G...

# ── Minter (Fireblocks account #2 — mint/burn/trustline) ────────────
MINTER_FIREBLOCKS_VAULT_ACCOUNT_ID=1
MINTER_PUBLIC_KEY=G...

# ── Per-role Fireblocks vault account IDs (CLI auto-selects) ────────
# Set only the roles you actually own a vault for. The CLI loads only the
# vars required by the invoked command — missing vars for roles you don't
# own never block other commands.
PAUSER_FIREBLOCKS_VAULT_ACCOUNT_ID=2
# ADMIN_FIREBLOCKS_VAULT_ACCOUNT_ID=
# BLOCK_OPERATOR_FIREBLOCKS_VAULT_ACCOUNT_ID=
# UNBLOCK_OPERATOR_FIREBLOCKS_VAULT_ACCOUNT_ID=
# FORCED_TRANSFER_MANAGER_FIREBLOCKS_VAULT_ACCOUNT_ID=
# YIELD_RECIPIENT_MANAGER_FIREBLOCKS_VAULT_ACCOUNT_ID=
# Public keys for each role are set under "Contract roles" below.

# ── Contract roles (npm run deploy) ──────────────────────────────────
# STEL1-5: each role is read independently. Setting any to the same
# value as another collapses the role separation the contract was
# designed for — only do this intentionally for local single-signer
# testing. There is no "dev-mode" deploy script that does this for you.
ADMIN_PUBLIC_KEY=G...                          # M0 Foundation top-level authority
# MINTER_PUBLIC_KEY (above)                    # Bridge / Fireblocks minter — reused
YIELD_RECIPIENT_MANAGER_PUBLIC_KEY=G...        # M0 (rotates yield recipient)
YIELD_RECIPIENT_PUBLIC_KEY=G...                # MoneyGram (claims yield)
FORCED_TRANSFER_MANAGER_PUBLIC_KEY=G...        # Crossmint (compliance forced transfers)
BLOCK_OPERATOR_PUBLIC_KEY=G...                 # May block / batch_block
UNBLOCK_OPERATOR_PUBLIC_KEY=G...                # May unblock / batch_unblock
PAUSER_PUBLIC_KEY=G...                         # Pauser of record

# ── Deploy (npm run deploy) ──────────────────────────────────────────
ASSET_CODE=TMGUSD                            # optional — defaults to TMGUSD
WASM_PATH=./target/wasm32v1-none/release/mintergateway.wasm

# ── Trustline (npm run trustline) ────────────────────────────────────
TRUSTLINE_ASSET_CODE=TMGUSD                  # issuer read from ISSUER_PUBLIC_KEY

# ── Invoke (npm run mint / burn / query) ─────────────────────────────
CONTRACT_ID=C...
MINT_TO=G...                                 # typically = MINTER_PUBLIC_KEY
MINT_AMOUNT=1000000000
BURN_AMOUNT=500000000
