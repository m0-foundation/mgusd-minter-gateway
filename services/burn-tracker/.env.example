HORIZON_URL=https://horizon-testnet.stellar.org
ASSET_CODE=
ASSET_ISSUER=G...
START_LEDGER=
RETRY_PENDING_INTERVAL_MS=3600000

# DynamoDB
AWS_REGION=us-east-1
BURNS_TABLE_NAME=Burns
STATE_TABLE_NAME=BurnTrackerState
API_ENABLED=true
API_PORT=3000
# If true, detect and store burns but do not submit reconcile_burn transactions
DRY_RUN=false

# Wrapper contract
CONTRACT_ID=C...

# SAC contract (for detecting burns via Soroban events)
SAC_CONTRACT_ID=C...

# Soroban RPC
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Fireblocks (admin signer — must be able to call reconcile_burn)
FIREBLOCKS_API_KEY=...
FIREBLOCKS_SECRET_PATH=/path/to/fireblocks-secret.key
FIREBLOCKS_VAULT_ACCOUNT_ID=0
FIREBLOCKS_ASSET_ID=XLM_TEST
FIREBLOCKS_BASE_PATH=sandbox
ADMIN_PUBLIC_KEY=G...
