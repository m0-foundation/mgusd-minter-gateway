# =============================================================================
# Stellar Minter Gateway — Deploy Environment
# =============================================================================
#
# Single template for both deploy paths. Copy to `.env` at the repo root:
#
#     cp scripts/deploy.env.example .env
#     $EDITOR .env
#
# Then run either:
#
#   ./scripts/deploy-testnet.sh                # bash + `stellar keys` (local dev)
#   cd scripts/deploy && npm run deploy:dry-run    # Fireblocks pipeline (dry)
#   cd scripts/deploy && npm run deploy:execute    # Fireblocks pipeline (submit)
#
# Both scripts load this same `.env`. Each ignores the variables it doesn't
# need — populate only the section(s) for the path you intend to use, plus
# the shared section.
#
# `.env` is gitignored — the filled-in version stays local. Every privileged
# role is its own variable; there is no role-collapsing default. For
# single-signer testnet/dev, set every role pubkey to the same value
# explicitly.
# =============================================================================


# -----------------------------------------------------------------------------
# Shared — used by both deploy paths
# -----------------------------------------------------------------------------

STELLAR_NETWORK=testnet                                  # testnet | public  (public triggers an interactive passphrase confirm on --execute)
ASSET_CODE=TMGUSD                                        # if a deploy fails partway, bump this (e.g. TMGUSD2) — the SAC for (ASSET_CODE, ISSUER) cannot be redeployed under the same pair
# WASM_PATH=./target/wasm32v1-none/release/mintergateway.wasm   # default; relative paths resolve from repo root, not cwd

# Optional RPC / Horizon overrides (Fireblocks pipeline only — the bash
# script uses `stellar` CLI's network config). Defaults are derived from
# STELLAR_NETWORK.
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# HORIZON_URL=https://horizon-testnet.stellar.org


# -----------------------------------------------------------------------------
# Issuer account public key (G..., 56 chars) — required by both paths
# -----------------------------------------------------------------------------
#
# Bash path: must match the pubkey behind ISSUER_KEY_NAME below
#            (`stellar keys public-key <ISSUER_KEY_NAME>`).
# Fireblocks path: must match the XLM_TEST/XLM wallet pubkey *inside* the
#            vault — Fireblocks UI → Vault Account <id> → Stellar Test asset →
#            Deposit address. NOT the vault id itself, NOT the vault's
#            display name.

ISSUER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# -----------------------------------------------------------------------------
# Wrapper role pubkeys (G..., 56 chars each) — required by both paths
# -----------------------------------------------------------------------------
#
# These are *constructor arguments* stored on-chain in the wrapper, not
# signing identities for the deploy itself. The deploy is signed only by
# ISSUER_PUBLIC_KEY's keys; these eight pubkeys just become the role
# holders the wrapper enforces post-deploy.
#
# Each role is read independently. Collapsing roles into a single signer is
# not allowed. For single-signer dev mode, set every var below to the same
# value explicitly.

# Top-level authority (M0). Cannot block/unblock/forced-transfer/etc.
# without first granting itself the relevant role — admin is *not* a
# super-role.
ADMIN_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bridge / minter — calls mint, burn, set_rate.
MINTER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Rotates yield recipient and calls claim_yield (M0).
YIELD_RECIPIENT_MANAGER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Passive — receives SAC tokens minted by claim_yield (e.g. MoneyGram).
YIELD_RECIPIENT_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Compliance forced transfers (typically Crossmint).
FORCED_TRANSFER_MANAGER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Initial block operator. More can be added via add_block_operator at runtime.
BLOCK_OPERATOR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Initial unblock operator. More can be added via add_unblock_operator at runtime.
UNBLOCK_OPERATOR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Pauser of record (M0).
PAUSER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# =============================================================================
# Bash path only — `stellar keys` identities
# =============================================================================
#
# ISSUER signs steps 1 and 5 (set_options + SAC.set_admin). In production
# this should resolve to a cold-key signer (Ledger via `stellar keys add
# --ledger`, or a Fireblocks-backed XDR-handoff flow).
#
# DEPLOYER signs steps 2, 3, 4 (SAC deploy, WASM upload, wrapper deploy).
# A funded operational keypair; gains no privilege over the resulting
# contract.
#
# For testnet/dev you can point both at the same identity. Setup:
#
#     stellar keys generate --network testnet deployer
#     stellar keys generate --network testnet issuer
#     stellar keys fund deployer --network testnet
#     stellar keys fund issuer   --network testnet

ISSUER_KEY_NAME=issuer
DEPLOYER_KEY_NAME=deployer


# =============================================================================
# Fireblocks path only — vault credentials
# =============================================================================
#
# All five deploy steps are signed by the same Fireblocks vault. Multi-
# approver policy (e.g. 2-of-3) is configured INSIDE the Fireblocks vault;
# the script just submits and polls. ISSUER_PUBLIC_KEY above must match the
# XLM_TEST/XLM wallet pubkey of FIREBLOCKS_VAULT_ACCOUNT_ID.
#
# Setup (one-time):
#
#   1. Generate an RSA-4096 keypair + CSR LOCALLY (Fireblocks never sees the
#      private key — it only ever holds the public half, wrapped in a CSR):
#        cd scripts/deploy
#        openssl req -new -newkey rsa:4096 -nodes \
#          -keyout fireblocks-secret.pem \
#          -out fireblocks.csr \
#          -subj '/O=<your-organization>'
#        chmod 600 fireblocks-secret.pem
#      Note: if a previous Fireblocks API user already exists, its matching
#      private PEM is somewhere on disk — reuse it instead of generating a
#      new pair (saves the upload step).
#
#   2. Upload `fireblocks.csr` to the FB API user:
#        Workspace UI → Developer Center → API Users → "Add API user" → select
#        role → CSR File field. FIREBLOCKS_API_KEY below = the resulting UUID.
#      (Or POST /v1/management/api_users { role, csrPem } if you have admin.)
#
#   3. Add an XLM_TEST (testnet) or XLM (mainnet) wallet to the vault
#      account in FB UI:
#        Vault → Vault Account <id> → Add Asset → Stellar Test → confirm
#      Copy the resulting deposit address (G...) into ISSUER_PUBLIC_KEY above.
#
#   4. Fund the vault wallet so it can pay deploy fees + storage rent:
#        curl "https://friendbot.stellar.org?addr=<the G... from step 3>"
#      (~10 XLM minimum for testnet; mainnet must be funded out-of-band.)

FIREBLOCKS_API_KEY=                                       # API user UUID (this *is* the API user ID — Developer Center → API Users)
FIREBLOCKS_SECRET_PATH=./fireblocks-secret.pem            # RSA private PEM you generated; its public half MUST be uploaded to the API user above (mismatch = 401 'invalid signature'). Read lazily, only --execute touches it.
FIREBLOCKS_BASE_PATH=sandbox                              # sandbox | us | eu | eu2 — must match where the API user was provisioned
FIREBLOCKS_ASSET_ID=XLM_TEST                              # XLM_TEST (testnet) | XLM (mainnet) — must match STELLAR_NETWORK above
FIREBLOCKS_VAULT_ACCOUNT_ID=                              # numeric vault id (e.g. 0, 3, 42), NOT the vault's display name

# Default 2-min poll often too short for multi-approver workflows; bump to
# 600s (10 min) or higher when human approvers are in the loop.
FIREBLOCKS_POLL_TIMEOUT_SECONDS=600
