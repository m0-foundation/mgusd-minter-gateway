# =============================================================================
# Stellar Minter Gateway — Deploy Environment
# =============================================================================
#
# Template for `scripts/deploy-testnet.sh`. Copy to `.env` at the repo root
# (where you run the script from):
#
#     cp scripts/deploy.env.example .env
#     $EDITOR .env
#     ./scripts/deploy-testnet.sh
#
# `.env` is gitignored — the filled-in version stays local. Per STEL1-5,
# every privileged role is its own variable; do NOT collapse roles.
# For single-signer testnet/dev, set every role pubkey to the same value
# explicitly.
# =============================================================================


# -----------------------------------------------------------------------------
# Network + asset
# -----------------------------------------------------------------------------

STELLAR_NETWORK=testnet
ASSET_CODE=TMGUSD

# home_domain — single source of truth for both roles:
#   • SEP-1 issuer account (set on-chain in step 1; resolves stellar.toml)
#   • SEP-55 WASM-meta cross-verify rebuild (must match what CI baked in)
# CI builds the WASM with vars.HOME_DOMAIN (GitHub repo Variable); set the
# repo Variable to the same value as this .env entry, or the cross-verify
# hash check will fail. Defaults to m0.org.
HOME_DOMAIN=m0.org


# -----------------------------------------------------------------------------
# WASM source — pick ONE of the two paths below
# -----------------------------------------------------------------------------
#
# Recommended path (attested): set RELEASE_TAG to a published GitHub release
# tag. The deploy script will:
#   1. gh release download    — fetches mintergateway_v<tag>.wasm to ./dist/
#   2. gh attestation verify  — proves it came from CI for this repo
#   3. local cross-build       — reproduces the bytes locally and refuses
#                                to deploy unless the hashes match (always on)
#   4. stellar contract upload — uploads the verified bytes on-chain
#
# Requires `gh auth login`, plus the Rust toolchain + stellar CLI for the
# local cross-build step. Run from a checkout at the RELEASE_TAG commit:
#   git fetch --tags origin && git checkout v1.0.0
#
# RELEASE_TAG=v1.0.0
# RELEASE_REPO=m0-foundation/stellar-minter-gateway   # default; override only for forks
# EXPECTED_WASM_HASH=                                  # optional sha256 hash-pin
#
# Local-build path (unattested, dev only): set WASM_PATH to a local file and
# set ALLOW_UNATTESTED_WASM=1 to acknowledge the bytes have no Sigstore
# provenance. The script will print a loud warning before deploying.
#
# WASM_PATH=./target/wasm32v1-none/release/mintergateway_v1.0.0.wasm
# ALLOW_UNATTESTED_WASM=1
# EXPECTED_WASM_HASH=                                  # optional sha256 hash-pin


# -----------------------------------------------------------------------------
# Signing identities — `stellar keys` identity NAMES (not pubkeys)
# -----------------------------------------------------------------------------
#
# ISSUER signs steps 1 and 5 (set_options + SAC.set_admin). In production
# this should resolve to a cold-key signer (Ledger via `stellar keys add
# --ledger`, or a Fireblocks-backed XDR-handoff flow).
#
# DEPLOYER signs steps 2, 3, 4 (SAC deploy, WASM upload, wrapper deploy).
# A funded operational keypair; gains no privilege over the resulting
# contract.
#
# For testnet/dev you can point both at the same identity. Setup commands:
#
#     stellar keys generate --network testnet deployer
#     stellar keys generate --network testnet issuer
#     stellar keys fund deployer --network testnet
#     stellar keys fund issuer   --network testnet

ISSUER_KEY_NAME=issuer
DEPLOYER_KEY_NAME=deployer


# -----------------------------------------------------------------------------
# Issuer account public key (G..., 56 chars)
# -----------------------------------------------------------------------------
#
# Must match the pubkey behind ISSUER_KEY_NAME. Get it with:
#     stellar keys public-key issuer

ISSUER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# -----------------------------------------------------------------------------
# Wrapper role pubkeys (G..., 56 chars each)
# -----------------------------------------------------------------------------
#
# STEL1-5: each role is read independently. Collapsing roles into a single
# signer is not allowed by the script. For single-signer dev mode, set
# every var below to the same value explicitly.

# Top-level authority (M0). Cannot block/unblock/forced-transfer/etc.
# without first granting itself the relevant role — admin is *not* a
# super-role.
ADMIN_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Bridge / minter — calls mint, burn, set_interest_rate.
MINTER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Rotates yield recipient and calls claim_yield (M0).
YIELD_RECIPIENT_MANAGER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Passive — receives SAC tokens minted by claim_yield (e.g. MoneyGram).
YIELD_RECIPIENT_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Compliance forced transfers (typically Crossmint).
FORCED_TRANSFER_MANAGER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Initial block operator. More can be added via add_block_operator at runtime.
BLOCK_OPERATOR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Initial unblock operator. More can be added via add_unblock_operator at runtime.
UNBLOCK_OPERATOR_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Pauser of record (M0).
PAUSER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Initial onboarder. More can be added via add_onboarder at runtime.
ONBOARDER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA


# =============================================================================
# Renounce-issuer pipeline (scripts/deploy-renounce.sh)
# =============================================================================
#
# Used only by `scripts/deploy-renounce.sh`. Leave commented for the default
# deploy-testnet.sh path; uncomment and set when running the renounce script.
#
# See docs/issuer-renunciation.md for the full picture. The renounce
# script permanently neuters the issuer key (master_weight=0 + AUTH_IMMUTABLE
# in one atomic set_options) once steps 1-5 have landed. After step 7, no key
# on earth can sign for the issuer account again.
#
# RENOUNCE_ISSUER (0|1) — opt-in gate. Without this, the renounce script
# behaves identically to deploy-testnet.sh (steps 0-5 + smoke, no renounce).
# Equivalent to passing --renounce-issuer on the command line.
#
# RENOUNCE_ISSUER=0


# ISSUER_RESERVE_XLM_THRESHOLD (number, default 5)
# Warn-only threshold for excess XLM that will be locked on the issuer
# account after renunciation. Operators should fund the issuer with the
# minimum required, since anything above the network minimum-reserve is
# locked forever once step 7 lands.
#
# ISSUER_RESERVE_XLM_THRESHOLD=5


# SAC_CONTRACT_ID, WRAPPER_CONTRACT_ID — required ONLY when running
# `deploy-renounce.sh --skip-deploy` (re-run renounce against an existing
# deploy where steps 1-5 already landed). Leave commented otherwise.
#
# SAC_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# WRAPPER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
